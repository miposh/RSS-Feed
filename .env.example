# App / Dynaconf
ENV_FOR_DYNACONF=production
BOT_TOKEN=your_telegram_bot_token

# PostgreSQL (used by both app and db service)
POSTGRES_DB=rss_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional app settings (written into .secrets.toml by entrypoint)
LOG_LEVEL_NAME=INFO
BOT_PARSE_MODE=HTML
RSS_CHECK_INTERVAL=300
CLEANUP_INTERVAL=86400
SENT_POSTS_RETENTION_DAYS=30

# Startup behavior
WAIT_FOR_DB=1
WAIT_FOR_DB_TIMEOUT=90
RUN_MIGRATIONS=1
AUTO_GENERATE_SECRETS_TOML=1

# Resource limits (compose)
APP_MEMORY_LIMIT=1g
DB_MEMORY_LIMIT=512m
APP_SHM_SIZE=256m
